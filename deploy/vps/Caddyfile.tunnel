{
    admin off
    auto_https off
}

:8080 {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    handle_path /api/* {
        reverse_proxy api:4000
    }
    handle {
        reverse_proxy web:3000
    }
}
