# Generate each password separately with: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_OWNER_HEX_PASSWORD
APP_DB_PASSWORD=REPLACE_APP_HEX_PASSWORD
BACKUP_DB_PASSWORD=REPLACE_BACKUP_HEX_PASSWORD
JWT_SECRET=REPLACE_JWT_HEX_SECRET
IMAGE_PREFIX=ghcr.io/highvoltage93/astro
# Full commit SHA from the successful Publish VPS images workflow.
IMAGE_TAG=sha-REPLACE_FULL_40_CHARACTER_COMMIT
# Bare hostname only; no scheme, slash or port.
SITE_HOST=REPLACE_DOMAIN_OR_IP_SSLIP_HOSTNAME
ACME_EMAIL=REPLACE_EMAIL
# Your actual public client IP, not the server IP. Keep private until release verification.
ALLOWED_CLIENT_IPS=127.0.0.1/32 ::1/128
