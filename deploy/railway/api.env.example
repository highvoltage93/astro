NODE_ENV=production
PORT=4000
# Neon pooled application connection, with a conservative Prisma connection limit.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require&connection_limit=5&pool_timeout=20
# Direct Neon connection, not the -pooler hostname; migrations only.
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
CORS_ORIGIN=https://REPLACE-WEB.up.railway.app
SWISSEPH_EPHE_PATH=/app/ephemeris
