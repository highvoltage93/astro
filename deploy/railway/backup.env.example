# Direct libpq connection. Do not copy Prisma-only query parameters such as schema/connection_limit.
BACKUP_DATABASE_URL=postgresql://BACKUP_USER:PASSWORD@HOST/DB?sslmode=require
BACKUP_BUCKET=REPLACE_PRIVATE_BUCKET
BACKUP_PREFIX=astro-production
BACKUP_S3_ENDPOINT=https://REPLACE_S3_COMPATIBLE_ENDPOINT
AWS_DEFAULT_REGION=REPLACE_REGION
AWS_ACCESS_KEY_ID=REPLACE_SCOPED_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_SCOPED_SECRET
# Public key only. Keep the private age identity outside Railway and Git.
BACKUP_AGE_RECIPIENT=age1REPLACE_PUBLIC_RECIPIENT
# A Healthchecks-compatible ping URL; independent monitoring catches missed jobs as well as failures.
BACKUP_HEALTHCHECK_URL=https://REPLACE_MONITOR_PING_URL
