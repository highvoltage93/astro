generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  CONSULTANT
  ADMIN
}

enum BirthProfileVisibility {
  PRIVATE
  LINK
  PUBLIC
}

enum ChartType {
  NATAL
  TRANSIT
  SYNASTRY
  PROGRESSION
  RETURN
}

enum InterpretationStatus {
  DRAFT
  REVIEWED
  PUBLISHED
  ARCHIVED
}

enum AiSessionMode {
  NATAL_SUMMARY
  CHAT
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  username       String          @unique
  passwordHash   String
  authVersion    Int             @default(0)
  passwordChangedAt DateTime?
  passwordReset  PasswordResetToken?
  accessGrants   AccessGrant[]
  locale         String          @default("uk")
  role           UserRole        @default(USER)
  lastLoginAt    DateTime?
  lastActiveAt   DateTime?
  birthProfiles  BirthProfile[]
  savedForecasts SavedForecast[]
  consultations Consultation[]
  consultationTemplates ConsultationTemplate[]
  calculationProfiles CalculationProfile[] @relation("OwnedCalculationProfiles")
  defaultCalculationProfileId String?
  defaultCalculationProfile CalculationProfile? @relation("DefaultCalculationProfile", fields: [defaultCalculationProfileId], references: [id], onDelete: SetNull)
  aiSessions     AiSession[]
  auditEvents    AuditEvent[]
  feedback       FeedbackReport[]
  knowledgeNotes KnowledgeNote[]
  clients        Client[]
  sharedKnowledgeUntil DateTime?
  knowledgeActivations KnowledgeActivation[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("users")
}

enum AccessPlan {
  TRIAL
  PRO
}

model Client {
  events      ClientEvent[]
  materials   ClientMaterial[]
  id          String   @id @default(cuid())
  ownerUserId String
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name        String
  email       String   @default("")
  phone       String   @default("")
  tags        String[] @default([])
  notes       String   @default("")
  revision    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerUserId, updatedAt, id])
  @@map("clients")
}

model AccessGrant {
  id        String @id @default(cuid())
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      AccessPlan
  source    String
  reason    String
  startsAt  DateTime @default(now())
  endsAt    DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, endsAt])
  @@map("access_grants")
}

model AccessSettings {
  id           String @id @default("default")
  trialEnabled Boolean @default(true)
  trialDays    Int @default(7)
  enforcementEnabled Boolean @default(false)
  transitionDays Int @default(14)
  launchedAt DateTime?
  revision     Int @default(0)

  @@map("access_settings")
}

model PasswordResetToken {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  authVersion Int
  email       String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuthRateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
  @@map("auth_rate_limits")
}

model AuthMailJob {
  id          String   @id @default(uuid())
  email       String
  createdAt   DateTime @default(now())
  availableAt DateTime @default(now())
  lockedUntil DateTime?
  attempts    Int      @default(0)

  @@index([availableAt, lockedUntil])
  @@map("auth_mail_jobs")
}

model BirthProfile {
  clientLinks     ClientMaterial[]
  id              String                 @id @default(cuid())
  ownerUserId     String?
  owner           User?                  @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  displayName     String
  birthDate       DateTime               @db.Date
  birthTime       String?
  birthTimeKnown  Boolean                @default(true)
  birthplaceName  String
  countryCode     String?
  latitude        Float
  longitude       Float
  timezone        String
  utcDateTime     DateTime?
  source          String                 @default("user")
  visibility      BirthProfileVisibility @default(PRIVATE)
  calculations    ChartCalculation[]
  knowledgeNotes  KnowledgeNote[]
  aiSessions      AiSession[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([ownerUserId])
  @@index([visibility])
  @@map("birth_profiles")
}

model ChartCalculation {
  id                       String       @id @default(cuid())
  birthProfileId           String?
  birthProfile             BirthProfile? @relation(fields: [birthProfileId], references: [id], onDelete: SetNull)
  chartType                ChartType
  zodiacType               String       @default("tropical")
  ayanamsa                 String?
  houseSystem              String
  calculationEngineVersion String
  inputHash                String
  settingsJson             Json
  resultJson               Json
  warningsJson             Json
  aiSessions               AiSession[]
  calculatedAt             DateTime     @default(now())

  @@index([birthProfileId])
  @@index([chartType])
  @@index([inputHash])
  @@map("chart_calculations")
}

model CalculationProfile {
  id            String   @id @default(cuid())
  ownerUserId   String
  owner         User     @relation("OwnedCalculationProfiles", fields: [ownerUserId], references: [id], onDelete: Cascade)
  defaultFor    User[]    @relation("DefaultCalculationProfile")
  name          String
  revision      Int      @default(1)
  schemaVersion Int      @default(1)
  configJson    Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ownerUserId, updatedAt])
  @@map("calculation_profiles")
}

model Consultation {
  clientLinks         ClientMaterial[]
  id                  String   @id
  ownerUserId         String
  owner               User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  sourceProfileId     String
  sourceCalculationId String
  sourceSnapshotJson  Json
  title               String
  status              String   @default("DRAFT")
  contentJson         Json
  privateNotes        String   @default("")
  revision            Int      @default(1)
  lastMutationId      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  history             ConsultationRevision[]

  @@index([ownerUserId, createdAt, id])
  @@index([ownerUserId, sourceProfileId])
  @@map("consultations")
}

model ConsultationRevision {
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  revision       Int
  title          String
  status         String
  contentJson    Json
  privateNotes   String
  savedAt        DateTime

  @@id([consultationId, revision])
  @@map("consultation_revisions")
}

model ConsultationTemplate {
  id             String   @id
  ownerUserId    String
  owner          User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  title          String
  category       String   @default("general")
  bodyJson       Json
  revision       Int      @default(1)
  lastMutationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ownerUserId, createdAt, id])
  @@map("consultation_templates")
}

model SavedForecast {
  clientLinks        ClientMaterial[]
  id                 String   @id @default(cuid())
  ownerUserId        String
  owner              User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  requestId          String
  inputHash          String
  kind               String
  title              String
  notes              String   @default("")
  schemaVersion      Int      @default(1)
  inputJson          Json
  resultJson         Json
  interpretationJson Json
  createdAt          DateTime @default(now())

  @@unique([ownerUserId, requestId])
  @@index([ownerUserId, createdAt, id])
  @@map("saved_forecasts")
}

model InterpretationItem {
  id                 String               @id @default(cuid())
  locale             String
  interpretationType String
  factorKey          String
  school             String               @default("psychological")
  title              String
  body               String
  readingLevel       String               @default("beginner")
  status             InterpretationStatus @default(DRAFT)
  version            Int                  @default(1)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([locale, factorKey, school, version])
  @@index([status])
  @@map("interpretation_items")
}

model GlossaryTerm {
  id        String   @id @default(cuid())
  locale    String
  slug      String
  term      String
  summary   String
  body      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locale, slug])
  @@map("glossary_terms")
}

model AiSession {
  id                 String            @id @default(cuid())
  userId             String?
  user               User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  birthProfileId     String?
  birthProfile       BirthProfile?     @relation(fields: [birthProfileId], references: [id], onDelete: SetNull)
  chartCalculationId String?
  chartCalculation   ChartCalculation? @relation(fields: [chartCalculationId], references: [id], onDelete: SetNull)
  mode               AiSessionMode
  promptVersion      String
  safetyStatus       String            @default("pending")
  messagesJson       Json
  createdAt          DateTime          @default(now())

  @@index([userId])
  @@index([birthProfileId])
  @@map("ai_sessions")
}

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_events")
}

model KnowledgeNote {
  id              String   @id
  ownerUserId     String
  owner           User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  title           String
  body            String
  tags            String[] @default([])
  conditionsJson  Json
  sourceProfileId String?
  sourceProfile   BirthProfile? @relation(fields: [sourceProfileId], references: [id], onDelete: SetNull)
  sourceLabel     String?
  archived        Boolean  @default(false)
  revision        Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  history         KnowledgeNoteRevision[]
  publication     KnowledgePublication?

  @@index([ownerUserId, archived, createdAt, id])
  @@index([sourceProfileId])
  @@map("knowledge_notes")
}

model KnowledgeNoteRevision {
  noteId         String
  note           KnowledgeNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  revision       Int
  title          String
  body           String
  tags           String[]
  conditionsJson Json
  archived       Boolean
  savedAt        DateTime @default(now())

  @@id([noteId, revision])
  @@map("knowledge_note_revisions")
}

model KnowledgePublication {
  noteId          String   @id
  note            KnowledgeNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  title           String
  body            String
  tags            String[] @default([])
  conditionsJson  Json
  sourceRevision  Int
  revision        Int      @default(1)
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  activations     KnowledgeActivation[]

  @@index([published, noteId])
  @@map("knowledge_publications")
}

model KnowledgeActivation {
  userId          String
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicationId   String
  publication     KnowledgePublication @relation(fields: [publicationId], references: [noteId], onDelete: Cascade)
  acceptedRevision Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@id([userId, publicationId])
  @@index([publicationId])
  @@map("knowledge_activations")
}

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

model FeedbackReport {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId      String
  authorUsername String
  authorEmail    String
  title          String
  description    String
  pagePath       String
  status         FeedbackStatus @default(NEW)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, requestId])
  @@index([status, createdAt, id])
  @@index([userId, createdAt])
  @@map("feedback_reports")
}

model ClientMaterial {
  id             String @id @default(cuid())
  clientId       String
  client         Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  birthProfileId String?
  birthProfile   BirthProfile? @relation(fields: [birthProfileId], references: [id], onDelete: Cascade)
  forecastId     String?
  forecast       SavedForecast? @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([clientId, birthProfileId])
  @@unique([clientId, forecastId])
  @@unique([clientId, consultationId])
  @@index([birthProfileId])
  @@index([forecastId])
  @@index([consultationId])
  @@map("client_materials")
}

model ClientEvent {
  id          String @id
  clientId    String
  client      Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  date        DateTime @db.Date
  approximate Boolean @default(false)
  category    String @default("other")
  notes       String @default("")
  revision    Int @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId, date, id])
  @@map("client_events")
}
